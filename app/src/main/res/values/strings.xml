    <string name="btn_battery_whitelist">加入电池优化白名单（防清理后台）</string>

    <!-- 保活提示 -->
    <string name="keepalive_title">清理后台后无障碍被关？</string>
    <string name="keepalive_hint">清后台被杀后无需去设置重开无障碍：只要开关仍为开启状态，重新打开本 App 系统会自动重连。若开关被系统关闭（常见于小米/华为等 ROM 管家深度清理），请进入手机管家，把本 App 加入「允许自启动 / 后台运行 / 不清理」白名单。</string>

    <!-- 状态 -->
    <string name="status_idle">未启动</string>
    <string name="status_running">运行中</string>
    <string name="status_no_accessibility">无障碍服务未开启</string>
    <string name="status_no_camera_permission">未授予摄像头权限</string>

    <!-- 前台服务通知 -->
    <string name="notif_channel_id">camera_gesture_channel</string>
    <string name="notif_channel_name">摄像头手势识别</string>
    <string name="notif_title">手势控制运行中</string>
