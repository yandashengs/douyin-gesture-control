<resources>
    <string name="app_name">手势控抖音</string>
    <string name="service_label">手势控制抖音无障碍服务</string>

    <!-- 主界面 -->
    <string name="title_main">手势控制抖音 · 洗澡专用</string>
    <string name="btn_start">开启手势控制</string>
    <string name="btn_stop">停止手势控制</string>
