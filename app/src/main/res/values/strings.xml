    <!-- 手势说明 -->
    <string name="help_title">手势说明</string>
    <string name="help_up">手掌向上挥 → 下一个视频</string>
    <string name="help_down">手掌向下挥 → 上一个视频</string>
    <string name="help_like">握拳再张开 → 双击点赞</string>
    <string name="help_comment">V 字手势(食指+中指) → 评论区</string>
    <string name="help_vol_up">拇指食指张开 → 音量加</string>
    <string name="help_vol_down">拇指食指捏合 → 音量减</string>
    <string name="help_pause">张开手保持 2 秒 → 暂停/播放</string>
